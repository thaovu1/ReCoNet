help(bootstrap_projection)
library(ReCoNet)
set.seed(123)
A <- matrix(rnorm(100), 10, 10)
B <- matrix(rnorm(100), 10, 10)
res_sf <- compare_networks(
A = A,
B = B,
method = "sign_flipping",
p = 5,
n_perm = 1000
)
res_sf
res_sf$p_value
res_rl <- compare_networks(
A = A,
B = B,
method = "relabeling",
statistic = "PND",
p = 6,
n_perm = 1000
)
res_rl$p_value
n <- 50
p <- 10
X1 <- matrix(rnorm(n * p), n, p)
X2 <- matrix(rnorm(n * p), n, p)
Y1 <- rnorm(n)
Y2 <- rnorm(n)
dim(X1)
dim(X2)
dim(A)
proj_res <- bootstrap_projection(
B = 500,
M = A,
X1 = X1,
Y1 = Y1,
X2 = X2,
Y2 = Y2,
npc = 3,
alpha = 0.05
)
